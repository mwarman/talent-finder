{
  "name": "@talent-finder/infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "cdk": "cdk",
    "cdk:deploy": "cdk deploy --require-approval never",
    "cdk:destroy": "cdk destroy --all --force",
    "precdk:synth": "npm run build",
    "cdk:synth": "cdk synth",
    "clean": "rimraf cdk.out coverage dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {},
  "devDependencies": {
    "aws-cdk": "2.1144.0",
    "aws-cdk-lib": "2.272.0",
    "constructs": "10.8.1",
    "dotenv": "18.0.5",
    "esbuild": "0.28.2"
  }
}
