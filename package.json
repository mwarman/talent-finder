{
  "name": "talent-finder",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A RAG AI application to find specific skill matches from a pool of candidates resumes, CVs, and other documents.",
  "keywords": [
    "ai",
    "rag",
    "aws",
    "bedrock",
    "lambda",
    "react",
    "typescript"
  ],
  "author": "Matthew Warman",
  "repository": {
    "type": "git",
    "url": "https://github.com/mwarman/talent-finder.git"
  },
  "license": "MIT",
  "workspaces": [
    "packages/shared",
    "packages/api",
    "packages/web",
    "packages/infra"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "husky": "9.1.7",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24.21.0 < 25"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
